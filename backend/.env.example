# Supabase → Project → Connect. Paste the URI WITHOUT the password part:
#   postgresql://postgres@db.<project-ref>.supabase.co:5432/postgres            (direct, IPv6)
#   postgresql://postgres.<project-ref>@aws-0-<region>.pooler.supabase.com:5432/postgres   (session pooler, IPv4)
DATABASE_URL=postgresql://postgres@db.<project-ref>.supabase.co:5432/postgres
DB_PASSWORD=your-database-password

# https://www.weatherapi.com → sign up → Dashboard → API key
WEATHERAPI_KEY=your-weatherapi-key
